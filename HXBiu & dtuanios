/* ============================================================
   MATRIX RAIN
   ============================================================ */
(function(){
  var canvas=document.getElementById('matrix-rain');
  var ctx=canvas.getContext('2d');
  var w,h,cols,drops;
  var chars='01アイウエオカキクケコサシスセソCENTERLOCKVIPPROMAXHXBIU<>{}[]#$%&*';
  var fontSize=14;
  function resize(){
    w=canvas.width=window.innerWidth;
    h=canvas.height=window.innerHeight;
    cols=Math.floor(w/fontSize);
    drops=[];for(var i=0;i<cols;i++)drops.push(Math.random()*-100);
  }
  function draw(){
    ctx.fillStyle='rgba(3,3,8,.08)';
    ctx.fillRect(0,0,w,h);
    ctx.font=fontSize+'px monospace';
    for(var i=0;i<cols;i++){
      var ch=chars[Math.floor(Math.random()*chars.length)];
      var y=drops[i]*fontSize;
      ctx.fillStyle=Math.random()>.85?'rgba(255,42,109,.8)':'rgba(5,217,232,.55)';
      ctx.shadowBlur=6;ctx.shadowColor=ctx.fillStyle;
      ctx.fillText(ch,i*fontSize,y);
      if(y>h&&Math.random()>.975)drops[i]=0;
      drops[i]++;
    }
    ctx.shadowBlur=0;
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize',resize);
  resize();draw();
})();

/* ============================================================
   HOME TAB - FEATURE LOGIC
   ============================================================ */
function triggerCommand(id,name){
  var checkbox=document.getElementById(id);
  var box=document.getElementById('box-'+id);
  var terminalLog=document.getElementById('terminal-log');
  if(!checkbox||!box||!terminalLog)return;
  var t=new Date().toLocaleTimeString('vi-VN',{hour12:false});
  if(checkbox.checked){
    box.classList.add('active');
    terminalLog.innerHTML+='<div class="log-line log-info">['+t+'] [INJECT] Khởi chạy module: '+name+'...</div>';
    setTimeout(function(){
      terminalLog.innerHTML+='<div class="log-line log-success">['+t+'] [OK] Module \''+name+'\' đã nạp thành công!</div>';
      terminalLog.scrollTop=terminalLog.scrollHeight;
    },400);
  }else{
    box.classList.remove('active');
    terminalLog.innerHTML+='<div class="log-line log-warn">['+t+'] [KILL] Giải phóng tiến trình: '+name+'</div>';
  }
  updateActiveCount();
  terminalLog.scrollTop=terminalLog.scrollHeight;
}
function updateActiveCount(){
  var checked=document.querySelectorAll('#sub-home .switch input[type="checkbox"]:checked');
  var el=document.getElementById('active-count');
  if(el)el.innerText='ACTIVE: '+checked.length+'/6';
}
function startExecution(){
  var terminalLog=document.getElementById('terminal-log');
  if(!terminalLog)return;
  var t=new Date().toLocaleTimeString('vi-VN',{hour12:false});

  // === HIỆN ẢNH NỀN KHI BẤM INJECT ===
  var bgMain = document.getElementById('bgMain');
  var bgRgb = document.getElementById('bgRgb');
  if (bgMain) bgMain.classList.add('show');
  if (bgRgb) bgRgb.classList.add('show');
  terminalLog.innerHTML+='<div class="log-line log-success">['+t+'] [BG] Kích hoạt wallpaper engine...</div>';

  // === CHẠY LOGIC CŨ ===
  terminalLog.innerHTML+='<div class="log-line log-info">['+t+'] [SYSTEM] Admin H X Biu thực thi tổng lệnh...</div>';
  var checked=document.querySelectorAll('#sub-home .switch input[type="checkbox"]:checked');
  if(checked.length===0){
    terminalLog.innerHTML+='<div class="log-line log-warn">['+t+'] [WARN] Chưa có module nào được kích hoạt!</div>';
  }else{
    checked.forEach(function(box){
      var name=box.parentElement.previousElementSibling.querySelector('h3').innerText;
      terminalLog.innerHTML+='<div class="log-line log-success">['+t+'] [OK] Module \''+name+'\' hoạt động ổn định.</div>';
    });
    terminalLog.innerHTML+='<div class="log-line log-success">['+t+'] [DONE] Hệ thống sẵn sàng. Tổng module: '+checked.length+'.</div>';
  }
  terminalLog.scrollTop=terminalLog.scrollHeight;
}

/* ============================================================
   MAIN TABS (HOME / SENS)
   ============================================================ */
(function(){
  var tabs=document.querySelectorAll('.main-tabs [data-mtab]');
  tabs.forEach(function(tab){
    tab.addEventListener('click',function(){
      tabs.forEach(function(x){x.classList.remove('active')});
      tab.classList.add('active');
      document.querySelectorAll('#sub-home, #sub-sens').forEach(function(p){p.classList.remove('active')});
      var p=document.getElementById('sub-'+tab.getAttribute('data-mtab'));
      if(p)p.classList.add('active');
    });
  });
})();

