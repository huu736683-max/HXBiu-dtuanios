  function generateSens(){
    var baseFF={general:92,redDot:88,scope2x:82,scope4x:76,sniper:62,freeLook:104};
    var baseFFMAX={general:98,redDot:93,scope2x:86,scope4x:80,sniper:65,freeLook:108};
    var base=S.version==='ffmax'?baseFFMAX:baseFF;
    var bp=BRAND_PRESET[S.brand]||BRAND_PRESET['Khác'];
    var brandTouch=bp.touch,brandTilt=bp.tilt;
    var rf=S.refreshRate;
    var rfF=rf<=60?.94:rf<=90?.98:rf<=120?1.00:rf<=144?1.03:1.05;
    var fps=S.fpsGame;
    var fpsF=fps<=30?1.10:fps<=60?1.02:fps<=90?.98:.95;
    var style={
      rush:{general:1.14,redDot:1.12,scope2x:1.08,scope4x:1.05,sniper:1.00,freeLook:1.15},
      balanced:{general:1,redDot:1,scope2x:1,scope4x:1,sniper:1,freeLook:1},
      control:{general:.86,redDot:.88,scope2x:.90,scope4x:.92,sniper:.96,freeLook:.88},
      sniper:{general:.92,redDot:.94,scope2x:.96,scope4x:.98,sniper:1.12,freeLook:.94}
    }[S.playstyle]||{general:1,redDot:1,scope2x:1,scope4x:1,sniper:1,freeLook:1};
    var sz=parseFloat(S.screenSize),szF=1;
    if(!isNaN(sz)&&sz>0){szF=sz<5.5?1.06:sz<6.5?1:sz<7?.96:.92}
    var out={};
    SLIDERS.forEach(function(d){
      var brandF=(d.id==='scope2x'||d.id==='scope4x'||d.id==='sniper')?brandTilt:brandTouch;
      var v=base[d.id]*brandF*rfF*fpsF*style[d.id]*szF;
      out[d.id]=clamp(v,0,200);
    });
    return out;
  }

  function updatePct(input){
    if(!input)return;
    var min=parseFloat(input.min)||0,max=parseFloat(input.max)||200;
    var pct=((parseFloat(input.value)-min)/(max-min))*100;
    input.style.setProperty('--pct',pct+'%');
  }

  function renderSliders(){
    var c=$('slidersContainer');if(!c)return;
    c.innerHTML='';
    SLIDERS.forEach(function(d){
      var row=document.createElement('div');row.className='sr';row.setAttribute('data-id',d.id);
      var head=document.createElement('div');head.className='sh';
      var name=document.createElement('div');name.className='sn';
      name.innerHTML='<span class="ico">'+d.icon+'</span>'+d.name;
      var val=document.createElement('div');val.className='sv';val.id='val-'+d.id;
      val.textContent=S.sens[d.id];
      var ctrl=document.createElement('div');ctrl.className='sc';
      var minus=document.createElement('button');minus.className='sb';minus.type='button';minus.textContent='−';
      var plus=document.createElement('button');plus.className='sb';plus.type='button';plus.textContent='+';
      ctrl.appendChild(minus);ctrl.appendChild(plus);
      head.appendChild(name);head.appendChild(val);head.appendChild(ctrl);
      var input=document.createElement('input');
      input.type='range';input.min=0;input.max=200;input.step=1;
      input.value=S.sens[d.id];input.id='range-'+d.id;
      row.appendChild(head);row.appendChild(input);c.appendChild(row);
      updatePct(input);
      input.addEventListener('input',function(){
        var v=clamp(input.value,0,200);S.sens[d.id]=v;val.textContent=v;updatePct(input);
      });
      minus.addEventListener('click',function(){
        var v=clamp(S.sens[d.id]-1,0,200);S.sens[d.id]=v;input.value=v;val.textContent=v;updatePct(input);
      });
      plus.addEventListener('click',function(){
        var v=clamp(S.sens[d.id]+1,0,200);S.sens[d.id]=v;input.value=v;val.textContent=v;updatePct(input);
      });
    });
  }

  function refreshSliders(){
    SLIDERS.forEach(function(d){
      var i=$('range-'+d.id),v=$('val-'+d.id);
      if(i){i.value=S.sens[d.id];updatePct(i)}
      if(v)v.textContent=S.sens[d.id];
    });
  }

